# ===========================================
# BiidMart Audio - Variables de Entorno
# ===========================================
# Copia este archivo como .env y ajusta los valores

# Servidor
NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# DeepSeek (IA)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_STORAGE_BUCKET=biidmart-media

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# Admin API Key (protege endpoints /api/knowledge, /api/clients, /api/payments)
ADMIN_API_KEY=your-admin-api-key-here

# OpenAI (embeddings para búsqueda semántica)
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
