{
  "name": "biidmart-audio-api",
  "version": "1.0.0",
  "description": "Backend para la automatización comercial de BiidMart Audio",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/config/migrations','dist/config/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "BiidMart Audio",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "concurrently": "^10.0.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
